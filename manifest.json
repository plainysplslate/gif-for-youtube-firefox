{
  "manifest_version": 3,
  "name": "GIF for YouTube Firefox",
  "version": "1.0",
  "description": "Post GIFs in YouTube comments just like the rayytor desktop extension.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*://*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*://*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
